---
import { activeTab, tabs } from './tabs';

const pathname = Astro.url.pathname;

const current = activeTab(pathname);
---

<nav class="nav-tabs" aria-label="Site sections">
	<ul role="list">
		{tabs.map((tab) => {
			const active = tab.id === current.id;
			return (
				<li>
					<a
						href={tab.href}
						class:list={['nav-tab', { active }]}
						aria-current={active ? 'page' : undefined}
					>
						<span class="tab-icon">
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tab.icon} />
						</span>
						<span>{tab.label}</span>
					</a>
				</li>
			);
		})}
	</ul>
</nav>

<style>

	.nav-tabs ul {
		list-style: none;
		padding: 0.3rem;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.25rem;
		background-color: var(--sl-color-bg-nav);
		border-radius: 0.75rem;
	}

	.nav-tab {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.3rem 0.4rem;
		border-radius: 0.5rem;
		border: 1px solid transparent;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
		white-space: nowrap;
	}

	.nav-tab:hover:not(.active) {
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	.nav-tab.active {
		border-color: var(--sl-color-accent);
		background-color: var(--sl-color-bg);
		color: var(--sl-color-white);
		font-weight: 600;
	}

	.tab-icon {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		opacity: 0.8;
	}

	.nav-tab.active .tab-icon {
		opacity: 1;
		color: var(--sl-color-accent);
	}
</style>
