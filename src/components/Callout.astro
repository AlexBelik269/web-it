---
/**
 * Coloured banner, mostly used to highlight a section heading.
 * Colours adapt to light and dark mode.
 */
interface Props {
	type?: 'note' | 'tip' | 'caution' | 'danger' | 'green' | 'yellow';
	title?: string;
}

const { type = 'note', title } = Astro.props;
---

<div class={`callout callout-${type}`}>
	{title && <div class="callout-title">{title}</div>}

	<div class="callout-content">
		<slot />
	</div>
</div>

<style>
	.callout {
		/* --c: border/tint colour, --c-text-light / --c-text-dark: heading colour per theme */
		--c-text: var(--c-text-dark);
		border-inline-start: 4px solid var(--c);
		background: color-mix(in srgb, var(--c) 14%, transparent);
		padding: 0.6rem 1rem;
		margin: 2rem 0 1rem;
		border-radius: 0.5rem;
	}
	:global([data-theme='light']) .callout {
		--c-text: var(--c-text-light);
		background: color-mix(in srgb, var(--c) 10%, white);
	}

	.callout-title {
		font-weight: 600;
		color: var(--c-text);
	}

	.callout-content > :global(:first-child) {
		margin-top: 0;
	}
	.callout-content > :global(:last-child) {
		margin-bottom: 0;
	}
	.callout-content :global(h1),
	.callout-content :global(h2),
	.callout-content :global(h3),
	.callout-content :global(h4),
	.callout-content :global(h5),
	.callout-content :global(h6) {
		margin: 0;
		font-weight: 600;
		color: var(--c-text);
		border: 0;
		padding: 0;
	}

	.callout-note {
		--c: #6366f1;
		--c-text-light: #3730a3;
		--c-text-dark: #c7d2fe;
	}
	.callout-tip {
		--c: #a855f7;
		--c-text-light: #7e22ce;
		--c-text-dark: #e9d5ff;
	}
	.callout-caution,
	.callout-yellow {
		--c: #f59e0b;
		--c-text-light: #92400e;
		--c-text-dark: #fde68a;
	}
	.callout-danger {
		--c: #e11d48;
		--c-text-light: #9f1239;
		--c-text-dark: #fecdd3;
	}
	.callout-green {
		--c: #10b981;
		--c-text-light: #047857;
		--c-text-dark: #a7f3d0;
	}
</style>
