# Copy this file to ".env" and fill in your FTP password.
# .env is listed in .gitignore, so your password never ends up on GitHub.

FTP_HOST=ftpx.forpsi.com
FTP_USER=www.alex-belik.cz
FTP_PASSWORD=
FTP_PATH=/www/it/

# "ftps" encrypts the connection. Use "ftp" only if ftps does not work.
FTP_PROTOCOL=ftps
